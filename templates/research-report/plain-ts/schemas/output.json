{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/satohubai/sato-agent-templates/templates/research-report/plain-ts/schemas/output.json",
  "title": "Research report output",
  "description": "Findings that are ATTRIBUTABLE \u2014 every one cites a source that was supplied to the run, and every number in one appears in a cited source. What the model proposed and the gate refused is kept in `rejected` with the reason, so the gate is auditable. Unknowns are a separate array and never mix with findings. Attributable is not the same as true: nothing here is a quality judgement.",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "question",
    "provider",
    "findings",
    "conflicts",
    "rejected",
    "unknowns",
    "sources_supplied",
    "sources_used",
    "source_kind",
    "chain_reads"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "sato.template.research-report.output/v1"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "question": {
      "type": "string",
      "maxLength": 1000
    },
    "provider": {
      "type": "string",
      "maxLength": 40,
      "description": "'fake' for a fixture run. Evidence from a fake-provider run is labelled as such and is never a model evaluation."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "source_ids",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topic",
          "source_ids",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 400
          },
          "source_ids": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "detail": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "statement",
          "reason",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 2000
          },
          "reason": {
            "enum": [
              "empty_statement",
              "uncited",
              "unknown_source",
              "unsupported_number"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000
          },
          "reason": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    },
    "sources_supplied": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "sources_used": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      },
      "description": "Derived from findings that SURVIVED the gate, never from what the model claimed to use."
    },
    "source_kind": {
      "enum": [
        "fixture",
        "fork",
        "rpc"
      ],
      "description": "Where the onchain reads came from: `fixture` replayed recorded RPC answers and contacted nothing; `fork` read a local anvil fork; `rpc` read the RPC the caller named."
    },
    "chain_reads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "chain",
          "ok",
          "block_number",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "maxLength": 40
          },
          "chain": {
            "type": "string",
            "maxLength": 40
          },
          "ok": {
            "type": "boolean"
          },
          "block_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    }
  }
}
