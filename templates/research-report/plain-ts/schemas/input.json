{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/satohubai/sato-agent-templates/templates/research-report/plain-ts/schemas/input.json",
  "title": "Research report input",
  "description": "A question and a CLOSED corpus: sources you supply, plus onchain reads the template makes through the Sato Kit's chain.read, each of which becomes one source. The template fetches nothing else, which is what makes the attribution rule enforceable. No key or signing material appears here.",
  "type": "object",
  "required": [
    "question"
  ],
  "additionalProperties": false,
  "properties": {
    "now": {
      "type": "string",
      "description": "Optional timestamp so a run is reproducible. Defaults to the run's clock."
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "sources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "url",
          "retrieved_at",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "maxLength": 60
          },
          "url": {
            "type": "string",
            "maxLength": 500
          },
          "retrieved_at": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "maxLength": 200000
          }
        }
      }
    },
    "chain_reads": {
      "type": "array",
      "description": "Onchain reads made through the kit's chain.read (read-only). Each becomes a source with this id whose text carries the exact value and block.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "chain",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "chain": {
            "enum": [
              "base",
              "base-sepolia"
            ]
          },
          "kind": {
            "enum": [
              "block_number",
              "native_balance",
              "erc20_balance",
              "erc20_total_supply"
            ]
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "Account for native_balance."
          },
          "token": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "ERC-20 contract for erc20_balance and erc20_total_supply."
          },
          "owner": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "description": "Holder for erc20_balance."
          },
          "label": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
