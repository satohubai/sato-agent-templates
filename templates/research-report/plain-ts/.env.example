# Names only. Copy to .env and fill in what your mode needs. Never commit .env.
# This template holds no key for any wallet: there is no signing variable.

# --mode fork / --mode rpc: the real model provider. Fixture mode never reads it.
ANTHROPIC_API_KEY=

# --mode fork: a local anvil fork of Base, e.g. http://127.0.0.1:8547
ANVIL_RPC_URL=

# --mode rpc: a Base or Base Sepolia RPC endpoint you choose (or pass --rpc).
SATO_RPC_URL_BASE=
