{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/satohubai/sato-agent-templates/templates/treasury-monitor/plain-ts/schemas/output.json",
  "title": "Treasury monitor output",
  "description": "Observed balances in BOTH exact base units and exact native decimal strings, an optional sourced valuation, threshold alerts fired on transitions only, and an explicit list of what could not be established. A null price_usd, value_usd or total_usd means UNKNOWN and never zero.",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "balances",
    "total_usd",
    "alerts",
    "unknowns",
    "checkpoint",
    "source_kind",
    "read_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "sato.template.treasury-monitor.output/v1"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "balances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "address_label",
          "address",
          "chain",
          "asset",
          "decimals",
          "base_units",
          "native",
          "price_usd",
          "value_usd",
          "price_source"
        ],
        "additionalProperties": false,
        "properties": {
          "address_label": {
            "type": "string",
            "maxLength": 80
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "chain": {
            "type": "integer",
            "minimum": 1
          },
          "asset": {
            "type": "string",
            "maxLength": 20
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 36
          },
          "base_units": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          },
          "native": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "price_usd": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "value_usd": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "price_source": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          }
        }
      }
    },
    "total_usd": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Null whenever any holding is unpriced OR no holding was observed. A partial sum is never presented as a total."
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "address_label",
          "address",
          "chain",
          "asset",
          "direction",
          "threshold_base_units",
          "observed_base_units",
          "observed_native"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "address_label": {
            "type": "string",
            "maxLength": 80
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "chain": {
            "type": "integer"
          },
          "asset": {
            "type": "string",
            "maxLength": 20
          },
          "direction": {
            "enum": [
              "below",
              "above"
            ]
          },
          "threshold_base_units": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          },
          "observed_base_units": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          },
          "observed_native": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "unknown_asset",
              "balance_unavailable",
              "price_unavailable",
              "threshold_unevaluated"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "firing"
      ],
      "additionalProperties": false,
      "properties": {
        "firing": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "source_kind": {
      "enum": [
        "fixture",
        "fork",
        "rpc"
      ],
      "description": "Which source produced this document. `fixture` replayed recorded RPC answers and contacted nothing; `fork` read a local anvil fork; `rpc` read the chain through the RPC the caller named. Every read went through the Sato Kit's chain.read."
    },
    "read_at": {
      "type": "array",
      "description": "The block each chain was read at.",
      "items": {
        "type": "object",
        "required": [
          "chain",
          "block_number"
        ],
        "additionalProperties": false,
        "properties": {
          "chain": {
            "type": "string",
            "maxLength": 40
          },
          "block_number": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      }
    }
  }
}
