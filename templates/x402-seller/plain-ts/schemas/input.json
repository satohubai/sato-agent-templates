{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "x402-seller config.json",
  "type": "object",
  "required": ["service", "networks", "max_timeout_seconds", "routes"],
  "properties": {
    "service": {
      "type": "object",
      "required": ["name", "public_url", "tags", "pay_to"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 32 },
        "public_url": { "type": "string", "pattern": "^https?://" },
        "tags": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 32 } },
        "pay_to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
      }
    },
    "networks": {
      "type": "object",
      "required": ["fork", "testnet"],
      "properties": {
        "fork": { "$ref": "#/$defs/network" },
        "testnet": { "$ref": "#/$defs/network" }
      }
    },
    "max_timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 600 },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "path", "price_base_units", "description", "mime_type", "query_example", "query_schema", "output_example"],
        "properties": {
          "method": { "const": "GET" },
          "path": { "type": "string", "pattern": "^/" },
          "price_base_units": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "mime_type": { "type": "string" },
          "query_example": { "type": "object" },
          "query_schema": { "type": "object" },
          "output_example": { "type": "object" }
        }
      }
    }
  },
  "$defs": {
    "network": {
      "type": "object",
      "required": ["chain", "network", "asset", "asset_symbol", "asset_decimals", "eip712", "facilitator"],
      "properties": {
        "chain": { "enum": ["base", "base-sepolia"] },
        "network": { "enum": ["eip155:8453", "eip155:84532"] },
        "asset": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "asset_symbol": { "type": "string" },
        "asset_decimals": { "type": "integer" },
        "eip712": { "type": "object", "required": ["name", "version"] },
        "facilitator": { "type": "string" }
      }
    }
  }
}
