{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "x402-seller out/report.json",
  "type": "object",
  "required": ["schema", "template", "mode", "network", "facilitator", "generated_at", "all_as_expected", "scenarios", "listing_file"],
  "properties": {
    "schema": { "const": "sato.x402-seller.report/v1" },
    "template": { "const": "x402-seller" },
    "mode": { "enum": ["fixture", "fork", "testnet"] },
    "network": { "type": "string" },
    "facilitator": { "enum": ["fake", "fork", "http"] },
    "generated_at": { "type": "string" },
    "all_as_expected": { "type": "boolean" },
    "listing_file": { "type": "string" },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "refused_reason", "payment_required", "payment_response", "receipt", "expected", "as_expected"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "integer" },
          "refused_reason": { "type": ["string", "null"] },
          "payment_required": { "type": ["object", "null"] },
          "payment_response": { "type": ["object", "null"] },
          "receipt": {
            "type": ["object", "null"],
            "required": ["schema", "amount", "pay_to", "payer", "transaction", "confirmation"],
            "properties": {
              "schema": { "const": "sato.x402-seller.receipt/v1" },
              "amount": { "type": "string", "pattern": "^[0-9]+$" },
              "confirmation": { "type": "object", "required": ["status", "method"] }
            }
          },
          "expected": { "type": "object" },
          "as_expected": { "type": "boolean" }
        }
      }
    }
  }
}
