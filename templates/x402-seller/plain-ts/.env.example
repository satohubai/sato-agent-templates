# Names only. Copy to .env and fill in what your mode needs. Never commit .env.
# This template holds no key: the seller only RECEIVES payments, so there is no
# signing variable, and there never is. The payee address is public config.

# --mode fork: a local anvil fork of Base, e.g. http://127.0.0.1:8547
ANVIL_RPC_URL=

# --mode testnet: a Base Sepolia RPC endpoint used to confirm settlements
# (defaults to https://sepolia.base.org when empty). An authenticated endpoint
# URL is a credential; keep it out of git.
SATO_RPC_URL_BASE_SEPOLIA=
