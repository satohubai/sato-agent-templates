{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "base-guarded-trader config.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "venue": { "type": "string", "enum": ["sato", "direct"], "description": "sato = Sato Swap, the labelled default, with a no-Sato-fee quote alongside; direct = no Sato call." },
    "amount_usdc": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,6})?$" },
    "over_cap_amount_usdc": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,6})?$" },
    "slippage_bps": { "type": "integer", "minimum": 0, "maximum": 5000 }
  }
}
