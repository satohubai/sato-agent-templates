{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "base-guarded-trader out/report.json",
  "type": "object",
  "required": ["schema", "mode", "user_agent", "model", "host", "venue", "market", "intents", "executed"],
  "properties": {
    "schema": { "const": "base-guarded-trader.report/v1" },
    "mode": { "type": "string", "enum": ["fixture", "fork", "testnet"] },
    "user_agent": { "type": "string" },
    "model": { "type": "string" },
    "host": {
      "type": "object",
      "required": ["framework", "agent", "tools", "needs_approval", "approvals", "calls"],
      "properties": {
        "framework": { "const": "openai-agents" },
        "agent": { "type": "string" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "needs_approval": { "type": "array", "items": { "type": "string" } },
        "calls": { "type": "array", "items": { "type": "string" } },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "gate", "approved", "by", "reason"],
            "properties": { "tool": { "type": "string" }, "gate": { "enum": ["interrupted", "none"] }, "approved": { "type": "boolean" }, "by": { "type": "string" }, "reason": { "type": "string" } }
          }
        }
      }
    },
    "venue": { "type": "string", "enum": ["sato", "direct"] },
    "market": { "type": "object" },
    "executed": { "type": "boolean" },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "demo_refusal", "intent_id", "action", "summary", "policy_ok", "refusals", "unsigned"],
        "properties": {
          "intent_id": { "type": "string", "pattern": "^si_[A-Za-z0-9_-]{43}$" },
          "policy_ok": { "type": "boolean" },
          "refusals": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rule", "limit", "observed", "message"],
              "properties": { "rule": { "type": "string" }, "limit": { "type": "string" }, "observed": { "type": "string" }, "message": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
