# Names only. Copy to .env and fill in what your mode needs. Never commit .env.

# --mode fork: a local anvil fork of Base, e.g. http://127.0.0.1:8545
ANVIL_RPC_URL=

# --mode testnet: Base Sepolia RPC and a Coinbase CDP managed wallet.
BASE_SEPOLIA_RPC_URL=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# --model claude: a real query() through the Claude Agent SDK. Not needed for
# the default --model scripted.
ANTHROPIC_API_KEY=
