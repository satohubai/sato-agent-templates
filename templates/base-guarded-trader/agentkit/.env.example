# Names only. Copy to .env and fill in what your mode needs. Never commit .env.

# --mode fork: a local anvil fork of Base, e.g. http://127.0.0.1:8545
ANVIL_RPC_URL=

# --mode testnet: Base Sepolia RPC and a Coinbase CDP smart wallet (AgentKit CdpSmartWalletProvider).
BASE_SEPOLIA_RPC_URL=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
