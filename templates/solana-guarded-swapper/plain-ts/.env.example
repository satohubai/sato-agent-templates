# Names only. Copy to .env and fill in what you need. Never commit .env.
# Neither value is a key. A URL with an API key in it is a secret: keep it here, not in a file that is committed.

# --mode live: a Solana mainnet RPC. If empty, the public endpoint (rate limited) is used.
SOLANA_RPC_URL=

# npm run preflight: the Solana RPC used to read receipts. If empty, the cluster's public endpoint is used.
SATO_RECEIPTS_RPC_URL=
