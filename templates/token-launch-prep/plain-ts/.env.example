# Names only. Copy to .env and fill in what your mode needs. Never commit .env.
# This template holds no key: there is no signing variable, and there never is.
# You sign the prepared transaction in your own wallet.

# --mode fork: a local anvil fork of Base, e.g. http://127.0.0.1:8547
ANVIL_RPC_URL=

# --mode rpc: a Base or Base Sepolia RPC endpoint you choose (or pass --rpc).
# An authenticated endpoint URL is a credential; keep it out of git.
SATO_RPC_URL_BASE=
